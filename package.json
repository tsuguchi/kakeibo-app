{
  "name": "kakeibo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "emulators": "firebase emulators:start --project demo-kakeibo",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kakeibo \"vitest run tests/rules\"",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@digital-go-jp/tailwind-theme-plugin": "^2.0.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@noble/hashes": "^2.4.0",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
